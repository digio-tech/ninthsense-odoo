<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="onboarding_template_view_list" model="ir.ui.view">
        <field name="name">ninthsense.onboarding.template.list</field>
        <field name="model">ninthsense.onboarding.template</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="active" widget="boolean"/>
                <field name="is_default"/>
                <field name="document_count" string="Documents"/>
            </list>
        </field>
    </record>

    <record id="onboarding_template_view_form" model="ir.ui.view">
        <field name="name">ninthsense.onboarding.template.form</field>
        <field name="model">ninthsense.onboarding.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Disabled" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Fresher"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="documents" string="Documents">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="document_type_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="mandatory" string="Required"/>
                                    <field name="accept_pdf" string="PDF"/>
                                    <field name="accept_jpg" string="JPG"/>
                                    <field name="accept_png" string="PNG"/>
                                    <field name="max_mb" string="Max MB"/>
                                </list>
                            </field>
                        </page>
                        <page name="mapping" string="Field Mapping">
                            <field name="mapping_ids">
                                <list editable="bottom">
                                    <field name="field_key"/>
                                    <field name="allowed_type_ids" column_invisible="1"/>
                                    <field name="source_type_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="fallback_type_id" options="{'no_create': True, 'no_open': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="onboarding_template_view_search" model="ir.ui.view">
        <field name="name">ninthsense.onboarding.template.search</field>
        <field name="model">ninthsense.onboarding.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="enabled" string="Enabled" domain="[('active', '=', True)]"/>
                <filter name="disabled" string="Disabled" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="onboarding_template_action" model="ir.actions.act_window">
        <field name="name">Onboarding Templates</field>
        <field name="res_model">ninthsense.onboarding.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem
        id="menu_onboarding_template"
        name="Onboarding Templates"
        parent="hr_recruitment.menu_hr_recruitment_configuration"
        action="onboarding_template_action"
        groups="hr_recruitment.group_hr_recruitment_user"
        sequence="90"
    />
</odoo>
