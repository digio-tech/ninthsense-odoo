<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_applicant_view_form" model="ir.ui.view">
        <field name="name">hr.applicant.view.form.inherit.ninthsense.onboarding</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <button name="archive_applicant" position="before">
                <button name="action_send_onboarding_link" type="object" string="Send onboarding link"
                        class="btn-primary"
                        invisible="not active or employee_id or not date_closed or onboarding_request_id"
                        groups="hr_recruitment.group_hr_recruitment_user"/>
                <button name="action_send_onboarding_link" type="object" string="Resend onboarding link"
                        invisible="not active or employee_id or not date_closed or not onboarding_request_id"
                        groups="hr_recruitment.group_hr_recruitment_user"/>
            </button>
            <xpath expr="//button[@name='action_create_meeting']" position="after">
                <button name="action_open_onboarding_requests" type="object" class="oe_stat_button"
                        icon="article"
                        invisible="onboarding_request_count == 0"
                        groups="hr_recruitment.group_hr_recruitment_user">
                    <field name="onboarding_request_count" invisible="1"/>
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Onboarding</span>
                        <span class="o_stat_value"><field name="onboarding_latest_state"/></span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Onboarding" name="onboarding"
                      groups="hr_recruitment.group_hr_recruitment_user">
                    <field name="onboarding_request_ids" readonly="1">
                        <list>
                            <field name="ref"/>
                            <field name="template_id"/>
                            <field name="state" widget="badge"/>
                            <field name="invite_state" widget="badge" decoration-danger="invite_state == 'failed'"/>
                            <field name="link_expires_at"/>
                            <field name="received_at"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
