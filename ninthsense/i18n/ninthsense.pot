#. module: ninthsense
#: model:mail.template,body_html:ninthsense.mail_template_onboarding_link
msgid ""
"<div>\n"
"    <p>Hello <t t-out=\"object.applicant_name or ''\">Candidate</t>,</p>\n"
"    <p>\n"
"        <t t-out=\"object.company_id.name or ''\">Company</t> needs a few documents from you\n"
"        to complete your onboarding.\n"
"    </p>\n"
"    <p>We have asked for <strong t-out=\"len(object.line_ids)\">5</strong> document(s). Uploading them takes a few minutes, and you only need to do it once.</p>\n"
"    <p>Open this link to upload your documents:</p>\n"
"    <p style=\"word-break: break-all;\"><a t-att-href=\"ctx.get('portal_url')\" t-out=\"ctx.get('portal_url') or ''\">https://portal.example.com/s/token</a></p>\n"
"    <p>\n"
"        The link is unique to you and works for <t t-out=\"ctx.get('link_validity_days') or ''\">14</t> days,\n"
"        until <strong t-out=\"format_date(object.link_expires_at)\">01/01/2026</strong>. Please do not forward it.\n"
"    </p>\n"
"    <p>If anything is unclear, reply to this email and we will help.</p>\n"
"</div>\n"
"        "
msgstr ""

