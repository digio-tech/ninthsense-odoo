<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="onboarding_send_wizard_view_form" model="ir.ui.view">
        <field name="name">ninthsense.onboarding.send.wizard.form</field>
        <field name="model">ninthsense.onboarding.send.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="applicant_id" invisible="1"/>
                <group>
                    <field name="template_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"
                            close="1" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
