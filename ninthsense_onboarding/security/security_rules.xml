<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A restriction (an access with no group) applies to every user, so it
         limits the recruitment groups to requests of their own companies,
         and to the documents, values and lines of those requests. -->
    <record id="access_onboarding_request_company" model="ir.access">
        <field name="name">ninthsense.onboarding.request.company</field>
        <field name="model_id" ref="model_ninthsense_onboarding_request"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="access_onboarding_request_line_company" model="ir.access">
        <field name="name">ninthsense.onboarding.request.line.company</field>
        <field name="model_id" ref="model_ninthsense_onboarding_request_line"/>
        <field name="operation">crud</field>
        <field name="domain">[('request_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="access_onboarding_document_company" model="ir.access">
        <field name="name">ninthsense.onboarding.document.company</field>
        <field name="model_id" ref="model_ninthsense_onboarding_document"/>
        <field name="operation">crud</field>
        <field name="domain">[('request_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="access_onboarding_value_company" model="ir.access">
        <field name="name">ninthsense.onboarding.value.company</field>
        <field name="model_id" ref="model_ninthsense_onboarding_value"/>
        <field name="operation">crud</field>
        <field name="domain">[('request_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="access_onboarding_fill_line_company" model="ir.access">
        <field name="name">ninthsense.onboarding.fill.line.company</field>
        <field name="model_id" ref="model_ninthsense_onboarding_fill_line"/>
        <field name="operation">crud</field>
        <field name="domain">[('request_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
